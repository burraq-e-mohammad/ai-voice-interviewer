# Copy this file to `.env` and fill in your values:
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (macOS / Linux)
# Never commit your real .env file - it contains your secret API key.

# --- Required ---------------------------------------------------------------
# Free key from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# --- LLM (optional) ----------------------------------------------------------
GROQ_MODEL=qwen/qwen3.8-27b
LLM_MAX_TOKENS=300
LLM_TIMEOUT_SECONDS=30

# --- Speech-to-Text (optional) ------------------------------------------------
# tiny | base | small | medium | large-v3   (bigger = more accurate, slower)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Text-to-Speech (optional) ------------------------------------------------
PIPER_VOICE_PATH=models/en_US-lessac-medium.onnx

# --- Security & limits (optional) ---------------------------------------------
MAX_AUDIO_BYTES=10485760
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# JSON list of browser origins allowed to call the API
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]
ENABLE_DOCS=true

# --- Conversation memory (optional) -------------------------------------------
MAX_HISTORY_TURNS=5
MAX_SESSIONS=1000
