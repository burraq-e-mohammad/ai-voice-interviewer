# Copy this file to `.env` and fill in your values:
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (macOS / Linux)
# Never commit your real `.env` file - it contains your secret API key.

# --- LLM Provider ('gemini' or 'groq') ---------------------------------------
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=gemini (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional fallback when LLM_PROVIDER=groq (key from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

LLM_MAX_TOKENS=350
LLM_TIMEOUT_SECONDS=30

# --- Interview Session (optional) --------------------------------------------
MAX_INTERVIEW_TURNS=20
MAX_SESSIONS=1000

# --- Speech-to-Text (faster-whisper, optional) -------------------------------
# tiny | base | small | medium | large-v3   (bigger = more accurate, slower)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Text-to-Speech (Piper, optional) ----------------------------------------
PIPER_VOICE_PATH=models/en_US-lessac-medium.onnx

# --- Security & Limits (optional) --------------------------------------------
MAX_AUDIO_BYTES=15728640
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:8000","http://127.0.0.1:8000"]
ENABLE_DOCS=true
